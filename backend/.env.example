# SAH-TECH Backend Environment Variables
# Copy this file to .env and fill in your values

# Server port
PORT=3001

# MongoDB Connection String
# Get this from MongoDB Atlas (https://cloud.mongodb.com)
# Format: mongodb+srv://<username>:<password>@<cluster>.mongodb.net/sah_tech?retryWrites=true&w=majority
MONGODB_URI=mongodb+srv://youruser:yourpass@cluster0.xxxxx.mongodb.net/sah_tech?retryWrites=true&w=majority

# CORS origins (comma-separated)
CORS_ORIGINS=http://localhost:5173,http://localhost:5174
